POSTGRES_DB=dashlab
POSTGRES_USER=dashlab
POSTGRES_PASSWORD=replace-me
JWT_SECRET=replace-with-at-least-32-random-characters
PROMETHEUS_URL=http://prometheus:9090
# Ex.: instance="node-exporter:9100" ou job="node"
PROMETHEUS_TARGET_LABELS=
# Ajuste para as interfaces e discos monitorados pelo seu exporter.
PROMETHEUS_NETWORK_LABELS=device!="lo"
PROMETHEUS_DISK_LABELS=device=~"nvme[0-9]+n[0-9]+|sd[a-z]+"
WEB_PORT=3000
