WEB_PORT=3000

# Imagem acompanhada pelo updater interno.
DASHLAB_IMAGE=ghcr.io/ferforastieri/dashlab-plus:latest

DASHLAB_AUTH_USER=dashlab
# O instalador gera este valor automaticamente.
DASHLAB_AUTH_PASSWORD=
OUTBOUND_ALLOWLIST=

# Token interno para o botão de atualização do Lab.
UPDATE_TOKEN=

# Opcional: deixe vazio quando não utilizar Prometheus.
PROMETHEUS_URL=
PROMETHEUS_TARGET_LABELS=
PROMETHEUS_NETWORK_LABELS=device!="lo"
PROMETHEUS_DISK_LABELS=device=~"nvme[0-9]+n[0-9]+|sd[a-z]+"
