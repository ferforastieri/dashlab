DATABASE_URL=postgresql://dashlab:change-me@localhost:5432/dashlab
JWT_SECRET=replace-with-at-least-32-random-characters
PORT=3001
PROMETHEUS_URL=
# Opcional: seletores de labels do seu Prometheus, por exemplo instance="node-exporter:9100"
PROMETHEUS_TARGET_LABELS=
PROMETHEUS_NETWORK_LABELS=device!="lo"
PROMETHEUS_DISK_LABELS=device=~"nvme[0-9]+n[0-9]+|sd[a-z]+"
